[Unit]
Description=Guichao Books MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=books
Group=books
WorkingDirectory=/opt/books
EnvironmentFile=/etc/books/mcp.env
ExecStart=/usr/bin/node /opt/books/server/mcp/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
