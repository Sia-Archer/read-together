# ChatGPT/Codex remote MCP adapter. Keep it on loopback and publish it through
# your own HTTPS reverse proxy, for example https://books.example.com/books-mcp/mcp.
BOOKS_CHATGPT_HOST=127.0.0.1
BOOKS_CHATGPT_PORT=18006
BOOKS_CHATGPT_REQUIRE_AUTH=true
BOOKS_CHATGPT_PUBLIC_BASE_URL=https://books.example.com/books-mcp

# Public base URL is required so OAuth can bind the exact MCP resource.
# Create four independent random values for this Books deployment. Do not
# reuse the bookshelf password, another MCP's OAuth values, or commit them.
BOOKS_CHATGPT_OAUTH_CLIENT_ID=replace-with-a-random-client-id
BOOKS_CHATGPT_OAUTH_CLIENT_SECRET=replace-with-a-random-client-secret
BOOKS_CHATGPT_OAUTH_ACCESS_TOKEN=replace-with-a-random-access-token
BOOKS_CHATGPT_OAUTH_REFRESH_TOKEN=replace-with-a-random-refresh-token

# Server-to-server access to Books Core. It must match READING_CHATGPT_CONTROL_TOKEN.
# Use a different value from the Home/Codex READING_MCP_CONTROL_TOKEN.
BOOKS_CHATGPT_CONTROL_TOKEN=replace-with-the-books-core-control-token
BOOKS_CORE_URL=http://127.0.0.1:18004
BOOKS_MCP_CORE_TIMEOUT_MS=8000

