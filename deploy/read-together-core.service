[Unit]
Description=Read Together Books Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=books
Group=books
WorkingDirectory=/opt/books
EnvironmentFile=/etc/books/core.env
ExecStart=/usr/bin/node /opt/books/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/books

[Install]
WantedBy=multi-user.target
